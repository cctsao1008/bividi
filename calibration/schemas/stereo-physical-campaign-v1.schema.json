{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bividi stereo physical campaign v1",
  "type": "object",
  "required": ["schema", "campaign_id", "specimen", "capture", "session_count", "stages"],
  "properties": {
    "schema": {"const": "bividi.calibration.stereo_physical_campaign.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "specimen": {"type": "object", "required": ["model", "serial"]},
    "capture": {"type": "object", "required": ["device_index", "mode_index", "pixel_format", "width", "height"]},
    "session_count": {"type": "integer", "minimum": 2},
    "stages": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}

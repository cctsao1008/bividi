{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cctsao1008/bividi/calibration/schemas/camera-imu-physical-campaign-v1.schema.json",
  "title": "Bividi camera-IMU physical calibration campaign plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "created_utc",
    "specimen",
    "capture",
    "dependencies",
    "dynamic_session_count",
    "policy_source",
    "root",
    "stages",
    "guardrails",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "bividi.calibration.camera_imu_physical_campaign.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "minLength": 1},
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "serial"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_index", "mode_index", "camera_time_reference", "time_offset_definition"],
      "properties": {
        "device_index": {"type": "integer", "minimum": 0},
        "mode_index": {"type": "integer", "minimum": 0},
        "camera_time_reference": {
          "enum": ["exposure_start", "exposure_midpoint", "exposure_end"]
        },
        "time_offset_definition": {
          "const": "t_imu_s = t_camera_reference_s + offset_s"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_acquisition_issue",
        "stereo_calibration_issue",
        "camera_imu_issue",
        "downstream_vio_issue",
        "kalibr_backend",
        "kalibr_revision"
      ],
      "properties": {
        "host_acquisition_issue": {"const": 35},
        "stereo_calibration_issue": {"const": 8},
        "camera_imu_issue": {"const": 47},
        "downstream_vio_issue": {"const": 46},
        "kalibr_backend": {"const": "ethz-asl/kalibr"},
        "kalibr_revision": {"type": "string", "minLength": 40, "maxLength": 40}
      }
    },
    "dynamic_session_count": {"type": "integer", "minimum": 2},
    "policy_source": {"type": ["string", "null"]},
    "root": {"const": "."},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "depends_on", "runtime", "evidence_class", "outputs", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "runtime": {"enum": ["bividi", "external_kalibr"]},
          "evidence_class": {"type": "string", "minLength": 1},
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "schema": {"type": "string", "minLength": 1}
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version"],
      "properties": {
        "tool": {"const": "plan_camera_imu_physical_campaign.py"},
        "tool_version": {"const": "1"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cctsao1008/bividi/calibration/schemas/imu-calibration-session-v1.schema.json",
  "title": "Bividi IMU calibration session provenance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "created_utc",
    "device",
    "imu_configuration",
    "captures",
    "analysis",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "bividi.calibration.imu_session_manifest.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "serial", "sdk_version", "device_type", "isp_version", "fpga_version"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1},
        "sdk_version": {"type": "string", "minLength": 1},
        "device_type": {"type": "string", "minLength": 1},
        "isp_version": {"type": "string", "minLength": 1},
        "fpga_version": {"type": "string", "minLength": 1}
      }
    },
    "imu_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "frame",
        "accelerometer_range_g",
        "gyroscope_range_dps",
        "output_data_rate_hz",
        "accelerometer_filter",
        "gyroscope_filter",
        "configuration_source"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "frame": {"type": "string", "minLength": 1},
        "accelerometer_range_g": {"type": "number", "exclusiveMinimum": 0},
        "gyroscope_range_dps": {"type": "number", "exclusiveMinimum": 0},
        "output_data_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "accelerometer_filter": {"type": "string", "minLength": 1},
        "gyroscope_filter": {"type": "string", "minLength": 1},
        "configuration_source": {"type": "string", "minLength": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "camera_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "width", "height", "nominal_fps", "transport"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "nominal_fps": {"type": "number", "exclusiveMinimum": 0},
        "transport": {"type": "string", "minLength": 1}
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/captureEvidence"}
    },
    "analysis": {
      "type": "array",
      "items": {"$ref": "#/$defs/analysisEvidence"}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warnings": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "kind"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string"},
        "tool_revision": {"type": "string"},
        "kind": {"enum": ["synthetic", "measured"]}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "summary_path",
        "summary_sha256",
        "summary_bytes",
        "summary_schema",
        "trace_path",
        "trace_sha256",
        "trace_bytes",
        "observed_device",
        "observed_mode"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "summary_path": {"type": "string", "minLength": 1},
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "summary_bytes": {"type": "integer", "minimum": 1},
        "summary_schema": {"const": "bividi.nori.imu_trace.v1"},
        "trace_path": {"type": "string", "minLength": 1},
        "trace_sha256": {"$ref": "#/$defs/sha256"},
        "trace_bytes": {"type": "integer", "minimum": 1},
        "observed_device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serial", "sdk_version", "device_type", "isp_version", "fpga_version"],
          "properties": {
            "serial": {"type": "string", "minLength": 1},
            "sdk_version": {"type": "string", "minLength": 1},
            "device_type": {"type": "string", "minLength": 1},
            "isp_version": {"type": "string", "minLength": 1},
            "fpga_version": {"type": "string", "minLength": 1}
          }
        },
        "observed_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "width", "height", "nominal_fps", "transport"],
          "properties": {
            "index": {"type": "integer", "minimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "nominal_fps": {"type": "number", "exclusiveMinimum": 0},
            "transport": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "analysisEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes", "schema"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "schema": {"type": "string", "minLength": 1}
      }
    }
  }
}
